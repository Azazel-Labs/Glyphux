<Project Sdk="Microsoft.NET.Sdk">
  <!-- Written by ferreal-build: the Ferreal exporter of the Glyphux module. A plugin of
       Unreal Build Tool: UBT finds *.ubtplugin.csproj files in a project's plugins, builds
       them, and Unreal Header Tool runs their exporters. UBT passes EngineDir when it builds
       this; set it yourself (or in a .props file next to this one) to open the project in an
       IDE. -->
  <Import Project="GlyphuxExporter.ubtplugin.csproj.props" Condition="Exists('GlyphuxExporter.ubtplugin.csproj.props')" />
  <Import Project="$(EngineDir)\Source\Programs\Shared\UnrealEngine.csproj.props" />

  <PropertyGroup>
    <!-- Unreal Engine 5.8's Unreal Build Tool runs on .NET 10. -->
    <TargetFramework>net10.0</TargetFramework>
    <Configuration Condition=" '$(Configuration)' == '' ">Development</Configuration>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <Configurations>Debug;Release;Development</Configurations>
    <RootNamespace>Ferreal</RootNamespace>
    <AssemblyName>Ferreal.Glyphux.Exporter</AssemblyName>
    <OutputPath>..\..\Binaries\DotNET\UnrealBuildTool\Plugins\GlyphuxExporter\</OutputPath>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="EpicGames.Build">
      <HintPath>$(EngineDir)\Binaries\DotNET\UnrealBuildTool\EpicGames.Build.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="EpicGames.Core">
      <HintPath>$(EngineDir)\Binaries\DotNET\UnrealBuildTool\EpicGames.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="EpicGames.UHT">
      <HintPath>$(EngineDir)\Binaries\DotNET\UnrealBuildTool\EpicGames.UHT.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnrealBuildTool">
      <HintPath>$(EngineDir)\Binaries\DotNET\UnrealBuildTool\UnrealBuildTool.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
