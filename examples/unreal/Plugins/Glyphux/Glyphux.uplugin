{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "0.4.1",
	"FriendlyName": "Glyphux",
	"Description": "Text drawn from multi-channel distance fields that the GPU generates as needed: sharp at any size, with outline, glow, shadow, color emoji and BBCode. A UMG widget, a scene component, text on any surface and text as Niagara particles.",
	"Category": "Rendering",
	"CreatedBy": "Azazel Labs",
	"DocsURL": "https://github.com/Azazel-Labs/Glyphux/tree/main/examples/unreal",
	"CanContainContent": true,
	"Modules": [
		{
			"Name": "GlyphuxShaders",
			"Type": "Runtime",
			"LoadingPhase": "PostConfigInit"
		},
		{
			"Name": "Glyphux",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		},
		{
			"Name": "GlyphuxNiagara",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		}
	],
	"Plugins": [
		{
			"Name": "ProceduralMeshComponent",
			"Enabled": true
		},
		{
			"Name": "Niagara",
			"Enabled": true
		}
	]
}
